{
  "description": "content-wand guards: SSRF and credential-path checks, publish gate, injection flags, output validation. Active only while the content-wand skill is in use.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/content-wand/scripts/run-hook.sh\" session_start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": ".*content-wand.*",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/content-wand/scripts/run-hook.sh\" user_prompt_expansion", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|WebFetch|WebSearch|Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/content-wand/scripts/run-hook.sh\" pre_tool_use", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/content-wand/scripts/run-hook.sh\" post_tool_use", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/content-wand/scripts/run-hook.sh\" stop", "timeout": 15 }
        ]
      }
    ]
  }
}
